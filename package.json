{
  "name": "diffwalk",
  "version": "0.1.0",
  "description": "Read code changes as an ordered sequence of explanations and exact diffs",
  "type": "module",
  "bin": {
    "diffwalk": "dist/diffwalk.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --target=bun --packages=external --outfile=dist/diffwalk.js",
    "diffwalk": "bun run ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@opentui/core": "0.5.8",
    "@opentui/react": "0.5.8",
    "diff": "9.0.0",
    "hunkdiff": "0.20.0",
    "react": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "pnpm@11.20.0"
}
